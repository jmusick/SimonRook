# Copy to .env for local development. Astro reads this at BUILD time; it is a
# different mechanism from .dev.vars, which the Pages Function reads at RUN time.
#
# Only PUBLIC_-prefixed variables are exposed to the browser. Never put the
# Email Sending token or the Turnstile secret here — they belong in .dev.vars.
#
# For production, set this in the Pages project under Settings -> Variables as a
# build variable, not a secret (it ships in the HTML either way).

# Cloudflare Turnstile site key. The Contact page renders its form only when
# this is set; without it the page falls back to the plain email address.
PUBLIC_TURNSTILE_SITE_KEY=
