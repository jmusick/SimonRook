---
import { Icon } from "astro-icon/components";
import { ACTIVE_SOCIALS, SITE_NAME, SITE_VERSION } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span class="footer-mark">{SITE_NAME}</span>

	{ACTIVE_SOCIALS.length > 0 && (
		<nav class="social-nav" aria-label="Author profiles">
			{ACTIVE_SOCIALS.map((s) => (
				<a
					href={s.href}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={s.label}
					class="social-link"
				>
					<Icon name={s.icon} aria-hidden="true" />
				</a>
			))}
		</nav>
	)}

	<span class="footer-legal">
		<span>© {year} {SITE_NAME}</span>
		<span aria-hidden="true">·</span>
		<span>v{SITE_VERSION}</span>
		<span aria-hidden="true">·</span>
		<a href="/privacy-policy/">Privacy Policy</a>
	</span>
</footer>
